<%# app/views/products/_inventory.html.erb %>
<% if product.inventory_count.positive? %>
  <p>In stock: <%= product.inventory_count %></p>
<% else %>
  <p>Out of stock</p>
  <p>Email me when available:</p>
  <%= form_with model: [product, Subscriber.new], local: true do |form| %>
    <%= form.email_field :email, placeholder: "Enter your email", required: true %>
    <%= form.submit "Submit" %>
  <% end %>
<% end %>
